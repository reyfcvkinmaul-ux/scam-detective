# Deployer wallet — funded with Base Sepolia ETH from a faucet (e.g. https://www.alchemy.com/faucets/base-sepolia)
PRIVATE_KEY=0x...

# Public RPC endpoint
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional — required only for `forge verify` on Basescan
BASESCAN_API_KEY=

# Public URL where badge metadata JSONs are hosted (must end with /).
# Leave empty to skip — you can call setBaseURI later.
BADGE_BASE_URI=https://scam-detective.vercel.app/badges/
